{
    "name": "hampel/close-api",
    "description": "A PHP client for the Close CRM REST API",
    "homepage": "https://github.com/hampel/close-api",
    "authors": [
        {
            "name": "Simon Hampel",
            "email": "simon@hampelgroup.com",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/hampel/close-api/issues",
        "source": "https://github.com/hampel/close-api"
    },
    "keywords": [
        "close",
        "close.com",
        "crm",
        "api",
        "psr-18"
    ],
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "ext-json": "*",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^2.0",
        "psr/log": "^1.0|^2.0|^3.0"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^8.2",
        "hampel/rig": "^1.1",
        "laravel/pint": "^1.30",
        "nyholm/psr7": "^1.8",
        "php-http/mock-client": "^1.6",
        "phpstan/phpstan": "^2.1.22",
        "phpunit/phpunit": "^12.0"
    },
    "suggest": {
        "guzzlehttp/guzzle": "A PSR-18 client to send requests with; any implementation will do",
        "guzzlehttp/psr7": "PSR-17 factories, found automatically when none are passed to Transport - as are nyholm/psr7 and laminas/laminas-diactoros"
    },
    "autoload": {
        "psr-4": {
            "Hampel\\CloseApi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hampel\\CloseApi\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": false
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "analyse": [
            "phpstan analyse",
            "phpstan analyse -c phpstan-harness.neon"
        ],
        "format": "pint",
        "lint": "pint --test",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ]
    }
}
